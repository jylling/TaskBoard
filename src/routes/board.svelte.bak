<script lang="ts">
	// This is done in a single file for clarity. A more factored version here: https://svelte.dev/repl/288f827275db4054b23c437a572234f6?version=3.38.2
	import { flip } from 'svelte/animate';
	import { dndzone } from 'svelte-dnd-action';

	import { fly, fade } from 'svelte/transition';
	import { quintOut } from 'svelte/easing';

	export let columnItems: any[] = [];
	const flipDurationMs = 200;
	function handleDndConsiderColumns(e: any) {
		columnItems = e.detail.items;
	}
	function handleDndFinalizeColumns(e: any) {
		columnItems = e.detail.items;
	}
	function handleDndConsiderCards(cid: any, e: any) {
		const colIdx = columnItems.findIndex((c) => c.id === cid);
		columnItems[colIdx].items = e.detail.items;
		columnItems = [...columnItems];
	}
	function handleDndFinalizeCards(cid: any, e: any) {
		const colIdx = columnItems.findIndex((c) => c.id === cid);
		columnItems[colIdx].items = e.detail.items;
		columnItems = [...columnItems];
	}
	function handleClick(e: any) {
		alert('dragabble elements are still clickable :)');
	}
	function handleDeleteCard(e: any) {
		e.currentTarget.closest('.card').remove();
	}

	let emptyDragImage: HTMLImageElement;

	if (typeof window !== 'undefined') {
		emptyDragImage = new Image();
		emptyDragImage.src =
			'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"></svg>';
	}
</script>

<div
	class="board"
	use:dndzone={{
		items: columnItems,
		flipDurationMs,
		type: 'columns',
		dropTargetStyle: {}
	}}
	on:consider={handleDndConsiderColumns}
	on:finalize={handleDndFinalizeColumns}
>
	{#each columnItems as column (column.id)}
		<div
			class="column relative overflow-hidden rounded-3xl bg-gray-100 shadow-2xl"
			animate:flip={{ duration: flipDurationMs }}
		>
			<div class="column-title">{column.name}</div>
			<div
				class="column-content"
				use:dndzone={{
					items: column.items,
					flipDurationMs,
					dropTargetStyle: {
						border: '1px dashed #93c5fd',
						borderRadius: '8px',
						marginBottom: '10px'
					}
				}}
				on:consider={(e) => handleDndConsiderCards(column.id, e)}
				on:finalize={(e) => handleDndFinalizeCards(column.id, e)}
			>
				{#each column.items as item (item.id)}
					<div class="card" animate:flip={{ duration: flipDurationMs }} on:click={handleClick}>
						<button
							class="card-delete"
							on:click|stopPropagation={handleDeleteCard}
							aria-label="Delete card"
						>
							✕
						</button>

						<div class="card-header">
							<h3 class="card-title">{item.name}</h3>
						</div>

						<p class="card-text">Her kan du placere en beskrivende tekst for kortet.</p>

						<div class="card-footer">
							<span class="card-tag">Task</span>
						</div>
					</div>
				{/each}
			</div>
		</div>
	{/each}
</div>

<style lang="css">
	.board {
		height: 90vh;
		width: 100%;
		padding: 0.5em;
		margin-bottom: 40px;
	}
	.column {
		height: 100%;
		width: 275px;
		padding: 0.5em;
		margin: 1em;
		float: left;

		/*Notice we make sure this container doesn't scroll so that the title stays on top and the dndzone inside is scrollable*/
		overflow-y: hidden;
	}
	.column-content {
		height: 100%;
		/* Notice that the scroll container needs to be the dndzone if you want dragging near the edge to trigger scrolling */
		overflow-y: scroll;
	}
	.column-title {
		margin-bottom: 1em;
		display: flex;
		justify-content: center;
		align-items: center;
	}
	.card {
		position: relative;

		border-radius: 12px;
		padding: 14px 16px 12px;
		margin-bottom: 12px;
		margin-right: 6px;
		box-shadow:
			0 2px 6px rgba(0, 0, 0, 0.06),
			0 8px 20px rgba(0, 0, 0, 0.04);
		cursor: pointer;
		background-color: rgba(00, 100, 100, 0.1);
	}

	.card-header {
		margin-bottom: 6px;
	}

	.card-title {
		font-size: 0.95rem;
		font-weight: 600;
		color: #1f2937;
		line-height: 1.3;
		margin: 0;
	}

	.card-text {
		font-size: 0.8rem;
		color: #4b5563;
		line-height: 1.4;
		margin: 6px 0 10px;
	}

	.card-footer {
		display: flex;
		justify-content: flex-start;
	}

	.card-tag {
		font-size: 0.7rem;
		padding: 2px 8px;
		border-radius: 999px;
		background: #e5e7eb;
		color: #374151;
		font-weight: 500;
	}

	/* Delete button */

	.card-delete {
		position: absolute;
		top: 6px;
		right: 6px;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		border: none;
		background: transparent;
		color: #9ca3af;
		font-size: 14px;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.card-delete:hover {
		background: #fee2e2;
		color: #b91c1c;
	}

	::global(.dndDragging::before) {
		outline: none !important;
		border: none !important;

		transform: rotate(1deg) scale(1.03);
		cursor: grabbing;
	}
	:global(.dndDragging:focus),
	:global(.dndDragging:focus-visible) {
		outline: none !important;
		border: none !important;
	}

	/* Eller fokusér på pseudo-elementet, der viser kopien */
	section[use] :global(.dndDragging::before):focus {
		border: none !important;
		box-shadow: none !important;
	}
</style>
